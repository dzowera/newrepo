<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<main>
  <% if (messages && messages.length > 0) { %>
    <div class="notice">
      <%= messages %>
    </div>
  <% } %>

  <% if (errors && errors.length > 0) { %>
    <ul class="errors">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <h1>Account Management</h1>
  <p>You're logged in</p>
</main>

<%- include('../partials/footer') %>