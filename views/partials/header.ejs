<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">Innocent Motors</a>
  </span>
  <div id="tools">
    <% if (loggedin && accountData && accountData.account_firstname) { %>
      <a href="/account/">Welcome <%= accountData.account_firstname %></a>
      <a href="/account/logout">Logout</a>
    <% } else { %>
      <a href="/account/login">My Account</a>
    <% } %>
  </div>
</header>