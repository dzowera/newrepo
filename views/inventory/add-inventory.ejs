<h1><%= title %></h1>

<form action="/inv/add-inventory" method="post" class="form-card">
  <label for="inv_make">Make</label>
  <input type="text" id="inv_make" name="inv_make"
         value="<%= typeof inv_make != 'undefined' ? inv_make : '' %>" required>

  <label for="inv_model">Model</label>
  <input type="text" id="inv_model" name="inv_model"
         value="<%= typeof inv_model != 'undefined' ? inv_model : '' %>" required>

  <label for="inv_price">Price</label>
  <input type="number" id="inv_price" name="inv_price"
         value="<%= typeof inv_price != 'undefined' ? inv_price : '' %>" required>

  <label for="inv_year">Year</label>
  <input type="number" id="inv_year" name="inv_year"
         value="<%= typeof inv_year != 'undefined' ? inv_year : '' %>" required>

  <label for="inv_description">Description</label>
  <textarea id="inv_description" name="inv_description" required>
    <%= typeof inv_description != 'undefined' ? inv_description : '' %>
  </textarea>

  <button type="submit" class="btn">Add Inventory Item</button>
</form>