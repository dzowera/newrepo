<h1><%= title %></h1>

<!-- Flash messages -->
<% if (typeof message != 'undefined' && message.length > 0) { %>
  <div class="notice"><%= message %></div>
<% } %>

<!-- Server-side validation errors -->
<% if (typeof errors != 'undefined' && errors.length > 0) { %>
  <ul class="notice">
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/inv/add-inventory" method="post" class="form-card">
  <label for="inv_make">Make</label>
  <input type="text" id="inv_make" name="inv_make"
         value="<%= typeof inv_make != 'undefined' ? inv_make : '' %>"
         required pattern="^[A-Za-z0-9]+$"
         title="Only letters and numbers allowed">

  <label for="inv_model">Model</label>
  <input type="text" id="inv_model" name="inv_model"
         value="<%= typeof inv_model != 'undefined' ? inv_model : '' %>"
         required pattern="^[A-Za-z0-9]+$"
         title="Only letters and numbers allowed">

  <label for="inv_year">Year</label>
  <input type="number" id="inv_year" name="inv_year"
         value="<%= typeof inv_year != 'undefined' ? inv_year : '' %>"
         required min="1900" max="2099">

  <label for="inv_price">Price</label>
  <input type="number" id="inv_price" name="inv_price"
         value="<%= typeof inv_price != 'undefined' ? inv_price : '' %>"
         required min="0">

  <label for="inv_miles">Mileage</label>
  <input type="number" id="inv_miles" name="inv_miles"
         value="<%= typeof inv_miles != 'undefined' ? inv_miles : '' %>"
         required min="0">

  <label for="inv_color">Color</label>
  <input type="text" id="inv_color" name="inv_color"
         value="<%= typeof inv_color != 'undefined' ? inv_color : '' %>"
         required pattern="^[A-Za-z]+$"
         title="Only letters allowed">

  <label for="inv_description">Description</label>
  <textarea id="inv_description" name="inv_description" required><%= typeof inv_description != 'undefined' ? inv_description : '' %></textarea>

  <label for="classificationList">Classification</label>
  <%- classificationList %> <!-- dynamically built select list -->

  <label for="inv_image">Image Path</label>
  <input type="text" id="inv_image" name="inv_image"
         value="<%= typeof inv_image != 'undefined' ? inv_image : '/images/no-image.png' %>"
         required>

  <label for="inv_thumbnail">Thumbnail Path</label>
  <input type="text" id="inv_thumbnail" name="inv_thumbnail"
         value="<%= typeof inv_thumbnail != 'undefined' ? inv_thumbnail : '/images/no-image-tn.png' %>"
         required>

  <button type="submit" class="btn">Add Inventory Item</button>
</form>